{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "rm -rf .next/dev"
    ],
    "frameworksBackend": {
      "region": "europe-west1",
      "memory": "1GiB",
      "cpu": 1,
      "concurrency": 80,
      "minInstances": 1
    }
  }
}
